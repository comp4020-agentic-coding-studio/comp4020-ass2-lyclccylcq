---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
import "../../styles/photo.css";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  mainAttrs={{ "data-page": "studio" }}
  {...siteConfig}
>
  <p>
    Each session turns the week's lecture into a photographic decision you can
    test with another person. Read the preparation before class, bring the
    requested material, and leave with a concrete frame, plan or shared
    agreement that moves the semester forward.
  </p>
  <SessionsGrid />
</ContentLayout>
