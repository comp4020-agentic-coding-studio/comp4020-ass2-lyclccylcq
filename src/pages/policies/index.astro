---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { siteConfig } from "../../site-config";
import "../../styles/photo.css";

const sections = [
  {
    id: "attendance",
    title: "Attendance",
    body: "Policy to be confirmed.",
  },
  {
    id: "academic-integrity",
    title: "Academic integrity",
    body: "Policy to be confirmed.",
  },
  {
    id: "ai-use",
    title: "AI use",
    body: "Policy to be confirmed.",
  },
  {
    id: "extensions",
    title: "Extensions",
    body: "Policy to be confirmed.",
  },
  {
    id: "accessibility",
    title: "Accessibility",
    body: "Policy to be confirmed.",
  },
  {
    id: "equipment",
    title: "Equipment",
    body: "Policy to be confirmed.",
  },
  {
    id: "safety",
    title: "Safety",
    body: "Policy to be confirmed.",
  },
];
---

<ContentLayout
  title="Policies and support"
  description="Course-wide rules for attendance, integrity, extensions and support. Still being confirmed."
  {...siteConfig}
>
  <div class="policies">
    {
      sections.map((section) => (
        <section aria-labelledby={section.id}>
          <h2 id={section.id}>{section.title}</h2>
          <p>{section.body}</p>
        </section>
      ))
    }
  </div>
</ContentLayout>

<style>
  .policies {
    max-width: 42rem;
  }

  .policies section + section {
    margin-block-start: clamp(2rem, 4vw, 3.5rem);
    padding-block-start: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--at-divider);
  }

  .policies h2 {
    font-family: var(--photo-font-display);
    font-size: var(--at-font-size-lg);
    color: var(--at-text-secondary);
  }

  .policies p {
    color: var(--at-text-secondary);
  }
</style>
