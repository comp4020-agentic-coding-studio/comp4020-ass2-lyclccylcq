---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import AssessmentsGrid from "../components/AssessmentsGrid.astro";
import CourseInfoList from "../components/CourseInfoList.astro";
import FeaturedLecture from "../components/FeaturedLecture.astro";
import MetaLine from "../components/MetaLine.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";
import { withBase } from "astro-theme-university/url";
import "../styles/photo.css";

const lectures = await getPublishedCollection("lectures");
const weeks = Array.from({ length: 12 }, (_, i) => i + 1);
---

<ContentLayout
  title={courseMeta.title}
  description="Take photos they'll actually like."
  heroImage={heroImage}
  heroImageAlt="A lecture theatre reduced to flat gold and black shapes, rows of seats sweeping past the frame, in a two-ink risograph print"
  {...siteConfig}
>
  <div class="hero-extra">
    <MetaLine parts={[courseMeta.code, courseMeta.session, "12 Weeks"]} />
    <a class="photo-cta" href={withBase("/course/")}>Explore the course</a>
  </div>

  <section aria-labelledby="section-01">
    <h2 id="section-01"><span class="photo-frame-number">01</span> The Course</h2>
    <p>
      A studio course in making photographs someone else will actually want to
      keep. The full shape of the semester — philosophy, weekly topics,
      assessment detail — is still being developed.
    </p>
  </section>

  <section aria-labelledby="section-02">
    <h2 id="section-02"><span class="photo-frame-number">02</span> The Semester</h2>
    <CardGrid columns={3}>
      {
        weeks.map((week) => {
          const lecture = lectures.find((entry) => entry.data.week === week);
          return (
            <Card
              headingLevel="h3"
              title={`Week ${String(week).padStart(2, "0")}`}
              href={`/weeks/${String(week).padStart(2, "0")}/`}
            >
              {lecture && <p>{lecture.data.title}</p>}
            </Card>
          );
        })
      }
    </CardGrid>
  </section>

  <section aria-labelledby="section-03">
    <h2 id="section-03"><span class="photo-frame-number">03</span> Assessment</h2>
    <AssessmentsGrid />
  </section>

  <section aria-labelledby="section-04">
    <h2 id="section-04"><span class="photo-frame-number">04</span> Featured Lecture</h2>
    <FeaturedLecture />
  </section>

  <section aria-labelledby="section-05">
    <h2 id="section-05"><span class="photo-frame-number">05</span> Course Information</h2>
    <CourseInfoList />
  </section>
</ContentLayout>

<style>
  .hero-extra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-block-end: 2rem;
  }

  section + section {
    margin-block-start: 3rem;
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
</style>
