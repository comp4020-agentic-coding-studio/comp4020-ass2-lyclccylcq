---
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import CameraRevealSequence from "../components/camera-intro/CameraRevealSequence.astro";
import type { GalleryWeek } from "../components/camera-intro/FullscreenLectureGallery.astro";
import MenuCamera from "../components/MenuCamera.astro";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";
import "../styles/photo.css";

const lectures = await getPublishedCollection("lectures");

const galleryWeeks: GalleryWeek[] = Array.from({ length: 12 }, (_, i) => {
  const n = i + 1;
  const padded = String(n).padStart(2, "0");
  const lecture = lectures.find((entry) => entry.data.week === n);
  return {
    week: n,
    number: padded,
    title: lecture?.data.title ?? `Week ${padded}`,
    href: `/weeks/${padded}/`,
  };
});
---

<ContentLayout
  title={courseMeta.title}
  description="Take photos they'll actually like."
  mainAttrs={{ "data-page": "home" }}
  {...siteConfig}
>
  <CameraRevealSequence
    kicker={`${courseMeta.code} · ${courseMeta.session}`}
    title={courseMeta.title}
    metaLine="Good portraits begin before the shutter."
    weeks={galleryWeeks}
  />
  <MenuCamera courseCode={courseMeta.code} courseTitle={courseMeta.title} />
</ContentLayout>

<style>
  /* CameraRevealSequence owns the page's <h1>; ContentLayout still renders its
     own fallback h1/lead into main when no heroImage is passed (it has no
     prop to suppress that), so hide the redundant pair on this page only. */
  :global(.at-main[data-page="home"] > h1:first-child),
  :global(.at-main[data-page="home"] > p.lead) {
    display: none;
  }

</style>
