---
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import AssessmentsGrid from "../components/AssessmentsGrid.astro";
import ContactSheetGrid from "../components/ContactSheetGrid.astro";
import CourseInfoList from "../components/CourseInfoList.astro";
import FeaturedLecture from "../components/FeaturedLecture.astro";
import MetaLine from "../components/MetaLine.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";
import { withBase } from "astro-theme-university/url";
import "../styles/photo.css";

const lectures = await getPublishedCollection("lectures");

const frames = Array.from({ length: 12 }, (_, i) => {
  const n = i + 1;
  const padded = String(n).padStart(2, "0");
  const lecture = lectures.find((entry) => entry.data.week === n);
  return {
    number: padded,
    title: `Week ${padded}`,
    href: `/weeks/${padded}/`,
    caption: lecture?.data.title,
  };
});
---

<ContentLayout
  title={courseMeta.title}
  description="Take photos they'll actually like."
  heroImage={heroImage}
  heroImageAlt="A lecture theatre reduced to flat gold and black shapes, rows of seats sweeping past the frame, in a two-ink risograph print"
  mainAttrs={{ "data-page": "home" }}
  {...siteConfig}
>
  <div class="hero-extra">
    <MetaLine parts={[courseMeta.code, courseMeta.session, "12 Weeks"]} />
    <a class="photo-cta" href={withBase("/course/")}>Explore the course</a>
  </div>

  <section aria-labelledby="section-01" class="section-lede accent-peach">
    <span class="photo-kicker-number" aria-hidden="true">01</span>
    <div>
      <h2 id="section-01">The Course</h2>
      <p>
        A studio course in making photographs someone else will actually want
        to keep. The full shape of the semester — philosophy, weekly topics,
        assessment detail — is still being developed.
      </p>
    </div>
  </section>

  <section aria-labelledby="section-02" class="section-wide accent-peach">
    <h2 id="section-02"><span class="photo-frame-number">02</span> The Semester</h2>
    <ContactSheetGrid frames={frames} />
  </section>

  <section aria-labelledby="section-03" class="section-split accent-lavender">
    <h2 id="section-03"><span class="photo-frame-number">03</span> Assessment</h2>
    <AssessmentsGrid />
  </section>

  <section aria-labelledby="section-04" class="section-wide accent-sky">
    <h2 id="section-04"><span class="photo-frame-number">04</span> Featured Lecture</h2>
    <FeaturedLecture />
  </section>

  <section aria-labelledby="section-05" class="accent-mint">
    <h2 id="section-05"><span class="photo-frame-number">05</span> Course Information</h2>
    <CourseInfoList />
  </section>
</ContentLayout>

<style>
  .hero-extra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: var(--at-spacing-lg);
    margin-block-end: 1rem;
    border-block-end: 1px solid var(--at-divider);
  }

  section + section {
    margin-block-start: clamp(3rem, 6vw, 6rem);
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .section-lede {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--at-spacing-lg);
  }

  .section-lede h2 {
    margin-block-start: 0;
  }

  .section-wide {
    grid-column: inset-start / content-end;
  }

  @media (width >= 640px) {
    .section-split {
      display: grid;
      grid-template-columns: minmax(0, 14rem) 1fr;
      gap: var(--at-spacing-xl);
      align-items: start;
    }

    .section-split h2 {
      margin-block-start: 0;
    }
  }

  @media (width < 640px) {
    .section-lede {
      grid-template-columns: 1fr;
    }

    .photo-kicker-number {
      font-size: clamp(2.5rem, 2rem + 4vw, 4rem);
    }
  }
</style>
