---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import CourseInfoList from "../../components/CourseInfoList.astro";
import { courseMeta } from "../../course-config";
import { siteConfig } from "../../site-config";
import "../../styles/photo.css";
---

<ContentLayout title="Course" description={courseMeta.description} {...siteConfig}>
  <section aria-labelledby="course-overview">
    <h2 id="course-overview">Course Overview</h2>
    <p>
      A placeholder introduction to {courseMeta.title}. The detailed course
      overview — what students spend their time on, and who it's for — is
      still being written.
    </p>
  </section>

  <section aria-labelledby="course-details">
    <h2 id="course-details">Course Details</h2>
    <CourseInfoList />
  </section>

  <section aria-labelledby="learning-outcomes">
    <h2 id="learning-outcomes">Learning Outcomes</h2>
    <p>By the end of this course, students will be able to:</p>
    <ol>
      <li>Outcome 1 — to be defined</li>
      <li>Outcome 2 — to be defined</li>
      <li>Outcome 3 — to be defined</li>
      <li>Outcome 4 — to be defined</li>
    </ol>
  </section>

  <section aria-labelledby="course-philosophy">
    <h2 id="course-philosophy">Course Philosophy</h2>
    <p>Reserved. The central philosophy of Partner Photography goes here.</p>
  </section>

  <section aria-labelledby="course-structure">
    <h2 id="course-structure">Course Structure</h2>
    <p>
      Each week pairs a lecture with studio/practical work; <a href={withBase("/resources/")}>resources</a>
      support both, and <a href={withBase("/assessments/")}>assessment</a> tracks progress across the
      semester. The detail of how these pieces fit together is still being
      worked out.
    </p>
  </section>
</ContentLayout>
