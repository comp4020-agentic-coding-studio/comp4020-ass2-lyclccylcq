---
// Shared "photo pending" block, matching the site's own established
// `:::info[Visual placeholder]` convention in lecture markdown — used
// wherever a section wants a real photograph that doesn't exist in the
// repo yet, instead of fabricating stock imagery.
export interface Props {
  /** What photo belongs here, e.g. "Harsh midday sun, direct overhead light". */
  caption: string;
  /** Loose warm/cool/neutral tint, useful for side-by-side comparison panels. */
  tone?: "warm" | "cool" | "neutral";
  /** CSS aspect-ratio value, e.g. "4 / 3" or "3 / 4". */
  ratio?: string;
}

const { caption, tone = "neutral", ratio = "4 / 3" } = Astro.props;
---

<div class="visual-placeholder" data-tone={tone} style={`--vp-ratio: ${ratio}`}>
  <span class="visual-placeholder-label">Visual placeholder</span>
  <p class="visual-placeholder-caption">{caption}</p>
</div>

<style>
  .visual-placeholder {
    aspect-ratio: var(--vp-ratio);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: var(--at-spacing-md);
    border: 1px dashed var(--photo-accent-deep);
    border-radius: var(--at-border-radius);
    background: color-mix(in oklch, var(--photo-accent) 8%, var(--at-bg-alt));
  }

  .visual-placeholder[data-tone="warm"] {
    background: color-mix(in oklch, var(--photo-peach) 12%, var(--at-bg-alt));
    border-color: var(--photo-peach-deep);
  }

  .visual-placeholder[data-tone="cool"] {
    background: color-mix(in oklch, var(--photo-sky) 12%, var(--at-bg-alt));
    border-color: var(--photo-sky-deep);
  }

  .visual-placeholder-label {
    font-family: var(--photo-metadata-font);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--at-text-muted);
  }

  .visual-placeholder-caption {
    margin: 0;
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
  }
</style>
