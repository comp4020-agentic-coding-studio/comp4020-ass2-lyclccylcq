---
import { getPublishedCollection } from "astro-course-university/content";
import Callout from "astro-theme-university/components/Callout.astro";
import { withBase } from "astro-theme-university/url";

const lectures = await getPublishedCollection("lectures");
const featured = lectures
  .filter((lecture) => lecture.data.slides)
  .sort((a, b) => a.data.week - b.data.week)
  .at(0);
---

{
  featured ? (
    <div class="featured-lecture photo-frame">
      <p class="photo-frame-number">WEEK {String(featured.data.week).padStart(2, "0")}</p>
      <h3>{featured.data.title}</h3>
      <p>{featured.data.description}</p>
      <a class="photo-cta" href={withBase(featured.data.slides!)}>
        Open the slides
      </a>
    </div>
  ) : (
    <Callout type="info">
      <p>Developing… no lecture has slides linked yet.</p>
    </Callout>
  )
}

<style>
  .featured-lecture {
    padding: var(--at-spacing-2xl);
    border: none;
    background: var(--at-bg-elevated);
    backdrop-filter: blur(12px);
    border-radius: var(--at-border-radius);
    box-shadow: var(--at-shadow-md);
    position: relative;
    overflow: hidden;
  }

  .featured-lecture::before,
  .featured-lecture::after {
    display: none;
  }

  .featured-lecture h3 {
    font-family: var(--photo-font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    font-weight: 400;
    margin-block: 0.4em 0.5em;
  }
</style>
