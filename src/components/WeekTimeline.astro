---
import { withBase } from "astro-theme-university/url";

// Vertical editorial timeline, alternating left/right, connected by a single
// rule — replaces the uniform equal-size ContactSheetGrid tiles the homepage
// used to render all twelve weeks with.
export interface TimelineWeek {
  number: string;
  title: string;
  href: string;
  caption?: string;
}

export interface Props {
  weeks: TimelineWeek[];
}

const { weeks } = Astro.props;
---

<section class="week-timeline-section" aria-labelledby="week-timeline-heading">
  <h2 id="week-timeline-heading" class="week-timeline-heading">The Semester</h2>
  <ol class="week-timeline">
    {
      weeks.map((week) => (
        <li class="week-timeline-entry">
          <a class="week-timeline-link" href={withBase(week.href)}>
            <span class="week-timeline-number" aria-hidden="true">
              {week.number}
            </span>
            <span class="week-timeline-body">
              <span class="week-timeline-title">Week {week.number}</span>
              {week.caption && <span class="week-timeline-caption">{week.caption}</span>}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .week-timeline-section {
    grid-column: inset-start / content-end;
  }

  .week-timeline-heading {
    margin-block-end: clamp(1.5rem, 4vw, 3rem);
  }

  .week-timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .week-timeline::before {
    content: "";
    position: absolute;
    inset-inline-start: 50%;
    inset-block: 0;
    width: 1px;
    background: var(--at-divider);
    transform: translateX(-50%);
  }

  .week-timeline-entry {
    display: flex;
    justify-content: center;
  }

  .week-timeline-link {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 1rem;
    max-width: 22rem;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .week-timeline-entry:nth-child(odd) .week-timeline-link {
    margin-inline-end: calc(50% + 1.5rem);
    text-align: end;
    grid-template-columns: 1fr auto;
  }

  .week-timeline-entry:nth-child(odd) .week-timeline-number {
    order: 2;
  }

  .week-timeline-entry:nth-child(even) .week-timeline-link {
    margin-inline-start: calc(50% + 1.5rem);
  }

  .week-timeline-number {
    font-family: var(--photo-font-display);
    font-weight: 400;
    font-size: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    line-height: 1;
    color: color-mix(in oklch, var(--photo-accent-deep) 42%, var(--photo-cream-alt) 58%);
  }

  .week-timeline-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .week-timeline-title {
    font-weight: 600;
  }

  .week-timeline-caption {
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
  }

  .week-timeline-link:hover .week-timeline-title,
  .week-timeline-link:focus-visible .week-timeline-title {
    color: var(--photo-accent-deep);
  }

  @media (width < 720px) {
    .week-timeline::before {
      inset-inline-start: 0.5rem;
    }

    .week-timeline-entry,
    .week-timeline-entry:nth-child(odd),
    .week-timeline-entry:nth-child(even) {
      justify-content: flex-start;
    }

    .week-timeline-entry:nth-child(odd) .week-timeline-link,
    .week-timeline-entry:nth-child(even) .week-timeline-link,
    .week-timeline-link {
      margin-inline: 0;
      padding-inline-start: 1.75rem;
      text-align: start;
      grid-template-columns: auto 1fr;
    }

    .week-timeline-entry:nth-child(odd) .week-timeline-number {
      order: initial;
    }

    .week-timeline-number {
      font-size: clamp(1.5rem, 1.2rem + 2vw, 2.25rem);
    }
  }
</style>
