---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Full-viewport opening: dominant media, oversized title, small descriptor,
// scroll cue. Owns the page's <h1> — pages using this pass no heroImage to
// ContentLayout and hide its fallback h1/lead via page-scoped CSS.
export interface Props {
  kicker: string;
  title: string;
  descriptor: string;
  image: ImageMetadata;
  imageAlt: string;
  scrollTargetId: string;
}

const { kicker, title, descriptor, image, imageAlt, scrollTargetId } = Astro.props;
---

<section class="hero-stage" aria-label={title}>
  <div class="hero-stage-media">
    <Image
      src={image}
      alt={imageAlt}
      class="hero-stage-image"
      loading="eager"
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
    />
    <div class="hero-stage-scrim" aria-hidden="true"></div>
  </div>
  <div class="hero-stage-content">
    <p class="hero-stage-kicker">{kicker}</p>
    <h1 class="hero-stage-title">{title}</h1>
    <p class="hero-stage-descriptor">{descriptor}</p>
  </div>
  <a class="hero-stage-scroll" href={`#${scrollTargetId}`}>
    <span class="hero-stage-scroll-line" aria-hidden="true"></span>
    <span>Scroll</span>
  </a>
</section>

<style>
  .hero-stage {
    grid-column: full-start / full-end;
    position: relative;
    /* Without its own stacking context, the media layer's z-index: -1 below
       would escape .hero-stage entirely and paint behind body's own
       background instead of just behind this section's content. */
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    align-content: end;
    color: var(--photo-cream);
  }

  .hero-stage-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-stage-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .hero-stage-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(20 16 10 / 12%) 0%, rgb(20 16 10 / 58%) 78%, rgb(20 16 10 / 76%) 100%);
  }

  .hero-stage-content {
    padding: clamp(1.5rem, 5vw, 4rem);
    padding-block-end: clamp(4.5rem, 11vw, 8rem);
    max-width: 62rem;
  }

  .hero-stage-kicker {
    font-family: var(--photo-metadata-font);
    font-size: var(--at-font-size-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
    opacity: 0.85;
  }

  .hero-stage-title {
    font-family: var(--photo-font-display);
    font-weight: 400;
    font-size: clamp(3rem, 1.4rem + 9vw, 9rem);
    line-height: 0.94;
    margin: 0 0 1rem;
    color: var(--photo-cream);
  }

  .hero-stage-descriptor {
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    max-width: 34ch;
    margin: 0;
    opacity: 0.92;
  }

  .hero-stage-scroll {
    position: absolute;
    inset-inline-start: clamp(1.5rem, 5vw, 4rem);
    inset-block-end: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
    font-family: var(--photo-metadata-font);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-stage-scroll-line {
    width: 1px;
    height: 2.5rem;
    background: currentColor;
    opacity: 0.7;
    transform-origin: top center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-stage-scroll-line {
      animation: hero-scroll-pulse 2.2s ease-in-out infinite;
    }
  }

  @keyframes hero-scroll-pulse {
    0%,
    100% {
      transform: scaleY(1);
      opacity: 0.4;
    }
    50% {
      transform: scaleY(0.55);
      opacity: 0.9;
    }
  }

  .hero-stage-scroll:focus-visible {
    outline: 2px solid var(--photo-cream);
    outline-offset: 4px;
  }
</style>
