---
import VisualPlaceholder from "./VisualPlaceholder.astro";

// Dedicated two-panel comparison layout (e.g. "HARSH NOON" vs "GOLDEN
// HOUR") — deliberately not two instances of the theme's Card, so it reads
// as one composed idea rather than a generic grid of two boxes.
export interface ComparisonPanel {
  label: string;
  body: string;
  placeholderCaption: string;
}

export interface Props {
  heading: string;
  left: ComparisonPanel;
  right: ComparisonPanel;
}

const { heading, left, right } = Astro.props;
---

<section class="visual-comparison" aria-labelledby="visual-comparison-heading">
  <h2 id="visual-comparison-heading" class="visual-comparison-heading">{heading}</h2>
  <div class="visual-comparison-panels">
    <div class="visual-comparison-panel" data-tone="warm">
      <p class="visual-comparison-label">{left.label}</p>
      <VisualPlaceholder caption={left.placeholderCaption} tone="warm" ratio="4 / 3" />
      <p class="visual-comparison-body">{left.body}</p>
    </div>
    <div class="visual-comparison-panel" data-tone="cool">
      <p class="visual-comparison-label">{right.label}</p>
      <VisualPlaceholder caption={right.placeholderCaption} tone="cool" ratio="4 / 3" />
      <p class="visual-comparison-body">{right.body}</p>
    </div>
  </div>
</section>

<style>
  .visual-comparison {
    grid-column: inset-start / content-end;
  }

  .visual-comparison-heading {
    text-align: center;
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
  }

  .visual-comparison-panels {
    display: grid;
    gap: clamp(1rem, 3vw, 2rem);
  }

  @media (width >= 720px) {
    .visual-comparison-panels {
      grid-template-columns: 1fr 1fr;
    }
  }

  .visual-comparison-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .visual-comparison-label {
    margin: 0;
    font-family: var(--photo-font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .visual-comparison-panel[data-tone="warm"] .visual-comparison-label {
    color: var(--photo-peach-deep);
  }

  .visual-comparison-panel[data-tone="cool"] .visual-comparison-label {
    color: var(--photo-sky-deep);
  }

  .visual-comparison-body {
    margin: 0;
    color: var(--at-text-secondary);
  }
</style>
