---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import MediaSlot from "./MediaSlot.astro";

// Staggered, asymmetric gallery — a 6-column grid with varied spans and
// per-tile vertical offsets, so tiles never align into uniform rows.
// Replaces the old fixed 4-column/uniform-row Contact Sheet layout (that
// pattern remains, unmodified, as ContactSheetGrid.astro for /weeks/).
export interface GalleryFrame {
  image?: ImageMetadata;
  alt?: string;
  caption: string;
  placeholderCaption: string;
  tone: "warm" | "cool" | "neutral";
  span: "sm" | "md" | "lg";
  offset?: "up" | "down" | "none";
}

export interface Props {
  heading: string;
  frames: GalleryFrame[];
}

const { heading, frames } = Astro.props;
---

<section class="photo-gallery" aria-labelledby="photo-gallery-heading">
  <h2 id="photo-gallery-heading">{heading}</h2>
  <ul class="photo-gallery-grid" role="list">
    {
      frames.map((frame) => (
        <li class="photo-gallery-tile" data-span={frame.span} data-offset={frame.offset ?? "none"}>
          <figure class="photo-gallery-figure">
            {frame.image ? (
              <Image src={frame.image} alt={frame.alt ?? ""} class="photo-gallery-image" loading="lazy" />
            ) : (
              <MediaSlot caption={frame.placeholderCaption} tone={frame.tone} ratio={frame.span === "lg" ? "3 / 2" : "1 / 1"} />
            )}
            <figcaption>{frame.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .photo-gallery {
    grid-column: full-start / full-end;
    padding-block: clamp(2rem, 5vw, 4rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
  }

  .photo-gallery h2 {
    max-width: 30ch;
    margin: 0 0 clamp(2rem, 5vw, 3rem);
  }

  .photo-gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .photo-gallery-tile[data-span="lg"] {
    grid-column: span 3;
  }

  .photo-gallery-tile[data-span="md"],
  .photo-gallery-tile[data-span="sm"] {
    grid-column: span 2;
  }

  @media (width >= 900px) {
    .photo-gallery-tile[data-offset="up"] {
      margin-block-start: -2.5rem;
    }

    .photo-gallery-tile[data-offset="down"] {
      margin-block-start: 2.5rem;
    }
  }

  .photo-gallery-figure {
    margin: 0;
  }

  .photo-gallery-figure :global(img),
  .photo-gallery-figure :global(.media-slot) {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .photo-gallery-tile[data-span="lg"] :global(img),
  .photo-gallery-tile[data-span="lg"] :global(.media-slot) {
    aspect-ratio: 3 / 2;
  }

  .photo-gallery-figure figcaption {
    margin-block-start: 0.5rem;
    font-family: var(--photo-metadata-font);
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
  }

  @media (width < 720px) {
    .photo-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .photo-gallery-tile[data-span="lg"],
    .photo-gallery-tile[data-span="md"],
    .photo-gallery-tile[data-span="sm"] {
      grid-column: span 2;
    }

    .photo-gallery-tile[data-offset] {
      margin-block-start: 0;
    }
  }
</style>
