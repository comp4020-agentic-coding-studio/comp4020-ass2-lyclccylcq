---
// An original front-view line-art camera for the homepage menu. It borrows
// only the interaction idea from the visual reference: the camera occupies
// the menu's second column and responds gently to pointer position. The
// artwork, geometry and branding are purpose-built for this course site.
export interface Props {
  courseCode: string;
  courseTitle: string;
}

const { courseCode } = Astro.props;
---

<div class="menu-camera" data-menu-camera aria-hidden="true">
  <div class="menu-camera-scene">
    <svg class="menu-camera-model" viewBox="0 0 1000 720" role="presentation">
      <defs>
        <radialGradient id="menu-lens-glass" cx="36%" cy="30%" r="76%">
          <stop offset="0" stop-color="#9eb3bd" stop-opacity="0.22" />
          <stop offset="0.28" stop-color="#26353c" stop-opacity="0.18" />
          <stop offset="0.7" stop-color="#081014" stop-opacity="0.48" />
          <stop offset="1" stop-color="#010304" stop-opacity="0.72" />
        </radialGradient>
        <radialGradient id="menu-viewfinder-glass" cx="30%" cy="24%" r="82%">
          <stop offset="0" stop-color="#78909d" stop-opacity="0.24" />
          <stop offset="0.4" stop-color="#182329" stop-opacity="0.36" />
          <stop offset="1" stop-color="#020405" stop-opacity="0.68" />
        </radialGradient>
      </defs>

      <ellipse cx="510" cy="642" rx="370" ry="28" fill="#000" opacity="0.24" />

      <g class="menu-camera-ghost" transform="translate(-20 14)" fill="none" stroke="#f7f5ef" stroke-width="1.4" opacity="0.12">
        <path d="M120 217Q120 180 157 180H838Q876 180 891 216L914 278V561Q914 610 865 610H151Q102 610 102 561V231Q102 217 120 217Z" />
        <path d="M105 278h808M108 548h802" />
        <rect x="174" y="218" width="158" height="74" rx="15" />
        <circle cx="520" cy="410" r="180" />
        <circle cx="520" cy="410" r="153" />
      </g>

      <g class="menu-camera-body" fill="none" stroke="#d9d7d2" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <g class="menu-camera-strap-lugs" stroke-width="2.4">
          <path d="M108 307H84q-18 0-18 20t18 20h20" />
          <path d="M906 307h24q18 0 18 20t-18 20h-18" />
        </g>

        <path d="M120 217Q120 180 157 180H838Q876 180 891 216L914 278V561Q914 610 865 610H151Q102 610 102 561V231Q102 217 120 217Z" fill="rgb(2 3 4 / 28%)" stroke-width="2.8" />
        <path d="M112 278V224Q112 190 151 190H837Q864 190 877 219L900 278Z" />
        <path d="M110 279h792" stroke-width="2.6" />
        <path d="M116 286h782" stroke-opacity="0.24" stroke-width="1.3" />

        <path d="M106 290H906V548H106Z" stroke-opacity="0.5" />
        <path d="M792 291h114v257H792q26-52 26-129T792 291Z" stroke-opacity="0.38" />
        <path d="M110 548h792v27q0 35-35 35H145q-35 0-35-35Z" />
        <path d="M128 585h756" stroke-width="2" opacity="0.62" />

        <g class="menu-camera-top-controls">
          <rect x="183" y="158" width="128" height="36" rx="10" />
          <path d="M195 164v25m11-28v31m11-31v31m11-31v31m11-31v31m11-31v31m11-31v31m11-31v31m11-28v25" stroke-width="1.3" opacity="0.66" />
          <rect x="704" y="158" width="132" height="36" rx="10" />
          <path d="M716 164v25m11-28v31m11-31v31m11-31v31m11-31v31m11-31v31m11-31v31m11-31v31m11-28v25" stroke-width="1.3" opacity="0.66" />
          <path d="M438 181v-23h164v23" />
          <path d="M455 168h130" stroke-width="3" opacity="0.62" />
          <circle cx="862" cy="205" r="14" />
          <circle cx="862" cy="205" r="6" fill="#b97d1c" stroke="none" />
        </g>

        <g class="menu-camera-viewfinder">
          <rect x="170" y="214" width="166" height="82" rx="16" />
          <rect x="185" y="228" width="136" height="54" rx="11" fill="url(#menu-viewfinder-glass)" stroke-width="2" />
          <path d="M198 238h96c-27 7-49 18-66 34h-30Z" fill="#d8e4e8" opacity="0.12" />
        </g>

        <g class="menu-camera-front-details">
          <rect x="748" y="222" width="94" height="58" rx="15" />
          <rect x="765" y="237" width="60" height="28" rx="8" fill="#b97d1c" stroke="none" opacity="0.74" />
          <circle cx="356" cy="339" r="19" />
          <path d="M356 329v20m-10-10h20" stroke="#c9c8c1" stroke-width="3" opacity="0.7" />
          <circle cx="827" cy="358" r="12" />
          <path d="M827 346v24" stroke="#b5b5af" stroke-width="3" opacity="0.55" />
          <text x="166" y="336">{courseCode.replace("SLOP", "SLOP ")}</text>
        </g>
      </g>

      <g class="menu-camera-lens" stroke="#d9d7d2" fill="none" stroke-linecap="round">
        <circle cx="520" cy="410" r="180" fill="rgb(2 3 4 / 34%)" stroke-width="2.8" />
        <circle cx="520" cy="410" r="160" stroke-width="2.2" />
        <circle cx="520" cy="410" r="151" stroke-width="2.2" stroke-dasharray="2 8" opacity="0.68" />
        <circle cx="520" cy="410" r="137" stroke-width="2.4" />
        <circle cx="520" cy="410" r="111" fill="url(#menu-lens-glass)" stroke-width="2.2" />
        <circle cx="520" cy="410" r="78" stroke-width="2" />
        <circle cx="520" cy="410" r="54" fill="url(#menu-lens-glass)" stroke-width="1.8" />
        <circle cx="500" cy="386" r="23" fill="#dce8eb" opacity="0.08" />
        <path d="M420 310c34-34 77-52 128-55M409 508c31 34 68 54 113 59" stroke-width="1.6" opacity="0.22" />
      </g>

      <g class="menu-camera-focus" fill="none" stroke="#b97d1c" stroke-width="3" opacity="0.72">
        <path d="M68 185v-30h30M932 185v-30h-30M68 563v30h30M932 563v30h-30" />
      </g>
    </svg>
  </div>
</div>

<script>
  function setupMenuCamera() {
    const camera = document.querySelector<HTMLElement>("[data-menu-camera]");
    const nav = document.querySelector<HTMLElement>(".at-nav");
    const wrapper = nav?.querySelector<HTMLElement>(".at-nav-links-wrapper");
    const toggle = nav?.querySelector<HTMLElement>(".at-nav-toggle");
    if (!camera || !wrapper || !toggle) return;

    if (camera.parentElement !== wrapper) wrapper.append(camera);
    if (camera.dataset.initialized === "true") return;
    camera.dataset.initialized = "true";

    const current = { rx: 0, ry: 0, lx: 0, ly: 0 };
    const target = { rx: 0, ry: 0, lx: 0, ly: 0 };
    let frame = 0;

    function render() {
      frame = 0;
      const ease = 0.22;
      current.rx += (target.rx - current.rx) * ease;
      current.ry += (target.ry - current.ry) * ease;
      current.lx += (target.lx - current.lx) * ease;
      current.ly += (target.ly - current.ly) * ease;

      camera?.style.setProperty("--menu-camera-rx", `${current.rx.toFixed(3)}deg`);
      camera?.style.setProperty("--menu-camera-ry", `${current.ry.toFixed(3)}deg`);
      camera?.style.setProperty("--menu-lens-x", `${current.lx.toFixed(2)}px`);
      camera?.style.setProperty("--menu-lens-y", `${current.ly.toFixed(2)}px`);

      const moving = Math.abs(target.rx - current.rx) + Math.abs(target.ry - current.ry)
        + Math.abs(target.lx - current.lx) + Math.abs(target.ly - current.ly) > 0.03;
      if (moving) frame = requestAnimationFrame(render);
    }

    function requestRender() {
      if (!frame) frame = requestAnimationFrame(render);
    }

    function resetCamera() {
      target.rx = 0;
      target.ry = 0;
      target.lx = 0;
      target.ly = 0;
      requestRender();
    }

    wrapper.addEventListener("pointermove", (event) => {
      if (toggle.getAttribute("aria-expanded") !== "true") return;
      const rect = wrapper.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width - 0.5) * 2));
      const y = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height - 0.5) * 2));
      target.rx = y * -12;
      target.ry = x * 18;
      target.lx = x * 10;
      target.ly = y * 7;
      requestRender();
    });
    wrapper.addEventListener("pointerleave", resetCamera);
    toggle.addEventListener("click", () => requestAnimationFrame(() => {
      if (toggle.getAttribute("aria-expanded") !== "true") resetCamera();
    }));
  }

  setupMenuCamera();
  document.addEventListener("astro:page-load", setupMenuCamera);
</script>

<style>
  .menu-camera {
    --menu-camera-rx: 0deg;
    --menu-camera-ry: 0deg;
    --menu-lens-x: 0px;
    --menu-lens-y: 0px;
    display: none;
    width: min(58vw, 52rem);
    perspective: 1100px;
    pointer-events: none;
  }

  :global(body:has(main[data-page="home"]) .at-nav-links-wrapper) .menu-camera {
    display: block;
  }

  .menu-camera-scene {
    transform-style: preserve-3d;
  }

  .menu-camera-model {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    transform: rotateX(var(--menu-camera-rx)) rotateY(var(--menu-camera-ry));
    transform-origin: 50% 52%;
    transform-style: preserve-3d;
    filter: drop-shadow(0 2rem 3rem rgb(0 0 0 / 58%));
    will-change: transform;
  }

  .menu-camera-lens {
    transform: translate(var(--menu-lens-x), var(--menu-lens-y));
    transform-box: fill-box;
    transform-origin: center;
    will-change: transform;
  }

  .menu-camera-body text {
    fill: #f7f5ef;
    stroke: none;
    font-family: var(--photo-metadata-font);
    font-size: 17px;
    letter-spacing: 0.15em;
    opacity: 0.58;
  }

  @media (width < 760px) {
    .menu-camera {
      width: min(94vw, 39rem);
      opacity: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-camera-model,
    .menu-camera-lens {
      transform: none;
    }
  }
</style>
