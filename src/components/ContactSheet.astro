---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import VisualPlaceholder from "./VisualPlaceholder.astro";

// Mixed-size photography gallery: real assets and placeholder tiles share
// one grid, with varying spans so no two tiles are the same size — the
// opposite of the site's other, uniform contact-sheet grid (which still
// serves /weeks/ unchanged).
export interface GalleryFrame {
  image?: ImageMetadata;
  alt?: string;
  caption: string;
  span?: "wide" | "tall" | "normal";
}

export interface Props {
  heading: string;
  frames: GalleryFrame[];
}

const { heading, frames } = Astro.props;
---

<section class="contact-sheet-section" aria-labelledby="contact-sheet-heading">
  <h2 id="contact-sheet-heading">{heading}</h2>
  <ul class="contact-sheet" role="list">
    {
      frames.map((frame) => (
        <li class="contact-sheet-tile" data-span={frame.span ?? "normal"}>
          {frame.image ? (
            <figure class="contact-sheet-figure">
              <Image src={frame.image} alt={frame.alt ?? ""} class="contact-sheet-image" />
              <figcaption>{frame.caption}</figcaption>
            </figure>
          ) : (
            <figure class="contact-sheet-figure">
              <VisualPlaceholder
                caption={frame.caption}
                ratio={frame.span === "tall" ? "3 / 4" : frame.span === "wide" ? "16 / 9" : "1 / 1"}
              />
            </figure>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .contact-sheet-section {
    grid-column: inset-start / content-end;
  }

  .contact-sheet {
    list-style: none;
    margin: var(--at-spacing-lg) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 9rem;
    gap: var(--at-spacing-md);
  }

  .contact-sheet-tile[data-span="wide"] {
    grid-column: span 2;
  }

  .contact-sheet-tile[data-span="tall"] {
    grid-row: span 2;
  }

  .contact-sheet-figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .contact-sheet-figure :global(.contact-sheet-image),
  .contact-sheet-figure :global(.visual-placeholder) {
    flex: 1;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .contact-sheet-image {
    object-fit: cover;
    border-radius: var(--at-border-radius);
    box-shadow: var(--at-shadow-md);
  }

  .contact-sheet-figure figcaption {
    margin-block-start: 0.4rem;
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
  }

  @media (width < 720px) {
    .contact-sheet {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 8rem;
    }
  }
</style>
