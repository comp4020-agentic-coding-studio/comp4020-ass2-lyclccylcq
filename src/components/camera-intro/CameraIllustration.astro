<style>
  .camera-illustration {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .camera-render {
    opacity: var(--b-materialize, 1);
    transform-origin: 50% 52%;
    transform: scale(calc(0.985 + var(--b-materialize, 1) * 0.015));
