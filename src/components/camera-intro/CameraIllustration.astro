---
// One original rear-view camera illustration, drawn once as SVG geometry
// and rendered twice: `.cam-lines` (stroke-only technical drawing) and
// `.cam-fill-core` / `.cam-fill-detail` / `.cam-highlight` (the same shapes,
// filled with metal gradients). Because every fill shape below is a
// byte-for-byte copy of its line counterpart's geometry, the two states
// stay perfectly registered — there is no separate "photo" asset and
// nothing here is traced from a real product. The composition (rear LCD
// flanked by a control cluster, a grip bulge, a viewfinder hump) takes its
// *idea* from a typical mirrorless/DSLR rear panel, not from any specific
// camera or from LAYR's artwork.
//
// The monitor's own screen area (the rect MonitorFrame docks onto) is left
// unpainted here — MonitorFrame is a sibling element positioned exactly
// over it and always covers it, so double-painting would be wasted work.
// See MonitorFrame.astro for the matching percentage coordinates, derived
// from this file's viewBox (170,390,660,400 of 1360x1000).
---

<svg
  class="camera-illustration"
  viewBox="0 0 1360 1000"
  preserveAspectRatio="xMidYMid meet"
  role="presentation"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="cam-grad-topplate" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#5a5f68" />
      <stop offset="100%" stop-color="#2c2f34" />
    </linearGradient>
    <linearGradient id="cam-grad-body" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#34373c" />
      <stop offset="100%" stop-color="#151619" />
    </linearGradient>
    <linearGradient id="cam-grad-grip" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#3a3d42" />
      <stop offset="100%" stop-color="#101012" />
    </linearGradient>
    <linearGradient id="cam-grad-griptexture" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1a1a1c" />
      <stop offset="100%" stop-color="#0b0b0c" />
    </linearGradient>
    <linearGradient id="cam-grad-bezel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#121214" />
      <stop offset="100%" stop-color="#020202" />
    </linearGradient>
    <radialGradient id="cam-grad-glass" cx="35%" cy="30%" r="75%">
      <stop offset="0%" stop-color="#3a4550" />
      <stop offset="55%" stop-color="#0b0e12" />
      <stop offset="100%" stop-color="#000000" />
    </radialGradient>
    <linearGradient id="cam-grad-control" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#4a4e55" />
      <stop offset="100%" stop-color="#1c1e21" />
    </linearGradient>
    <linearGradient id="cam-grad-highlight" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- Always-visible seams and strap lugs: fine structural linework present
       in both the sketch and the completed illustration. -->
  <g class="cam-seams" fill="none" stroke="var(--photo-cream)" stroke-width="2.5" stroke-linecap="round">
    <line x1="72" y1="156" x2="1218" y2="156" opacity="0.4" />
    <line x1="1150" y1="232" x2="1150" y2="726" opacity="0.4" />
    <path d="M100 878 Q660 908 1200 858" opacity="0.3" />
    <circle cx="112" cy="112" r="20" opacity="0.5" />
    <circle cx="1298" cy="204" r="18" opacity="0.5" />
  </g>

  <!-- Technical line drawing: every part below, stroke-only. Fades out as
       --b-materialize advances. -->
  <g
    class="cam-lines"
    fill="none"
    stroke="var(--photo-cream)"
    stroke-width="3"
    stroke-linejoin="round"
    stroke-linecap="round"
  >
    <rect x="60" y="140" width="1180" height="790" rx="46" />
    <rect x="70" y="70" width="1160" height="90" rx="24" />
    <rect x="1150" y="220" width="180" height="520" rx="80" />
    <rect x="1175" y="260" width="110" height="420" rx="55" />
    <path d="M560 70 L560 26 Q560 6 585 6 L735 6 Q760 6 760 26 L760 70 Z" />
    <rect x="610" y="0" width="100" height="14" rx="3" />
    <rect x="595" y="170" width="170" height="110" rx="24" />
    <rect x="625" y="190" width="110" height="70" rx="10" />
    <rect x="150" y="370" width="700" height="440" rx="20" />
    <rect x="95" y="420" width="44" height="30" rx="6" />
    <rect x="95" y="470" width="44" height="30" rx="6" />
    <circle cx="117" cy="582" r="22" />
    <rect x="95" y="630" width="44" height="30" rx="6" />
    <path d="M900 430 A 120 120 0 0 1 1140 430" stroke-width="26" />
    <circle cx="1010" cy="560" r="95" />
    <circle cx="1010" cy="560" r="34" />
    <rect x="995" y="440" width="30" height="26" rx="6" />
    <rect x="995" y="655" width="30" height="26" rx="6" />
    <rect x="1105" y="545" width="26" height="30" rx="6" />
    <rect x="890" y="545" width="26" height="30" rx="6" />
    <circle cx="940" cy="760" r="24" />
    <circle cx="1010" cy="760" r="24" />
    <circle cx="1080" cy="760" r="24" />
    <rect x="970" y="385" width="80" height="30" rx="15" />
    <circle cx="995" cy="400" r="10" />
  </g>

  <!-- Filled core: the main chassis, gradient-shaded metal. Identical
       geometry to the corresponding shapes in .cam-lines above. -->
  <g class="cam-fill-core" stroke="var(--photo-cream)" stroke-width="1.5" stroke-opacity="0.3">
    <rect x="60" y="140" width="1180" height="790" rx="46" fill="url(#cam-grad-body)" />
    <rect x="70" y="70" width="1160" height="90" rx="24" fill="url(#cam-grad-topplate)" />
    <rect x="1150" y="220" width="180" height="520" rx="80" fill="url(#cam-grad-grip)" />
    <rect x="1175" y="260" width="110" height="420" rx="55" fill="url(#cam-grad-griptexture)" stroke-opacity="0.15" />
    <rect x="150" y="370" width="700" height="440" rx="20" fill="url(#cam-grad-bezel)" />
  </g>

  <!-- Filled detail: viewfinder, controls, dials. Identical geometry to
       the corresponding shapes in .cam-lines above. -->
  <g class="cam-fill-detail" stroke="var(--photo-cream)" stroke-width="1.5" stroke-opacity="0.3">
    <path d="M560 70 L560 26 Q560 6 585 6 L735 6 Q760 6 760 26 L760 70 Z" fill="url(#cam-grad-topplate)" />
    <rect x="610" y="0" width="100" height="14" rx="3" fill="#111214" />
    <rect x="595" y="170" width="170" height="110" rx="24" fill="url(#cam-grad-grip)" />
    <rect x="625" y="190" width="110" height="70" rx="10" fill="url(#cam-grad-glass)" stroke-opacity="0.15" />
    <rect x="95" y="420" width="44" height="30" rx="6" fill="url(#cam-grad-control)" />
    <rect x="95" y="470" width="44" height="30" rx="6" fill="url(#cam-grad-control)" />
    <circle cx="117" cy="582" r="22" fill="url(#cam-grad-control)" />
    <rect x="95" y="630" width="44" height="30" rx="6" fill="url(#cam-grad-control)" />
    <path d="M900 430 A 120 120 0 0 1 1140 430" fill="none" stroke="url(#cam-grad-control)" stroke-width="26" stroke-opacity="1" stroke-linecap="round" />
    <circle cx="1010" cy="560" r="95" fill="none" stroke="url(#cam-grad-control)" stroke-width="20" stroke-opacity="1" />
    <circle cx="1010" cy="560" r="34" fill="url(#cam-grad-control)" />
    <rect x="995" y="440" width="30" height="26" rx="6" fill="#2a2c30" />
    <rect x="995" y="655" width="30" height="26" rx="6" fill="#2a2c30" />
    <rect x="1105" y="545" width="26" height="30" rx="6" fill="#2a2c30" />
    <rect x="890" y="545" width="26" height="30" rx="6" fill="#2a2c30" />
    <circle cx="940" cy="760" r="24" fill="url(#cam-grad-control)" />
    <circle cx="1010" cy="760" r="24" fill="url(#cam-grad-control)" />
    <circle cx="1080" cy="760" r="24" fill="url(#cam-grad-control)" />
    <rect x="970" y="385" width="80" height="30" rx="15" fill="#131416" />
    <circle cx="995" cy="400" r="10" class="cam-power-dot" fill="var(--photo-accent)" />
  </g>

  <!-- Specular highlights and cast shadow: appear last, on top of the
       fills, for a dimensional rather than flat-icon read. -->
  <g class="cam-highlight" fill="none" stroke-linecap="round">
    <path d="M110 148 Q660 96 1210 148" stroke="url(#cam-grad-highlight)" stroke-width="6" />
    <path d="M1160 250 Q1240 260 1160 700" stroke="url(#cam-grad-highlight)" stroke-width="5" />
    <ellipse cx="655" cy="210" rx="34" ry="16" fill="#8fa4b8" opacity="0.18" />
  </g>
</svg>

<style>
  .camera-illustration {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .cam-lines {
    opacity: calc(1 - var(--b-materialize, 1));
    transition: opacity 0.05s linear;
  }

  .cam-fill-core {
    opacity: min(1, calc(var(--b-materialize, 1) * 1.8));
    filter: drop-shadow(0 calc(6px * var(--b-materialize, 1)) calc(18px * var(--b-materialize, 1)) rgb(0 0 0 / 55%));
  }

  .cam-fill-detail {
    opacity: max(0, calc((var(--b-materialize, 1) - 0.25) * 1.8));
  }

  .cam-highlight {
    opacity: max(0, calc((var(--b-materialize, 1) - 0.5) * 2));
  }

  .cam-power-dot {
    opacity: calc(0.55 + 0.45 * var(--b-poweron, 1));
    filter: drop-shadow(0 0 calc(7px * var(--b-poweron, 1)) var(--photo-accent));
  }

  @media (prefers-reduced-motion: reduce) {
    .cam-fill-core,
    .cam-fill-detail,
    .cam-highlight,
    .cam-power-dot {
      transition: none;
    }
  }
</style>
