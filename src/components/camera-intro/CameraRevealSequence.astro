---
import StickyCameraStage from "./StickyCameraStage.astro";
import type { GalleryWeek } from "./FullscreenLectureGallery.astro";
import IdentityLayer from "./IdentityLayer.astro";
import IntroGalleryStrip from "./IntroGalleryStrip.astro";

// The homepage's signature opening. A giant, original SVG line drawing of a
// rear-view camera (CameraIllustration) fills the sticky stage; as the
// visitor scrolls, the exact same SVG geometry gains illustrated materials,
// shading and highlights in place — same position and silhouette
// throughout, never a different camera, never assets swapped in. Its rear
// monitor (MonitorFrame) then wakes up, its
// two shutters open from the centre to reveal FullscreenLectureGallery —
// mounted once, always present behind them — and the monitor expands to
// fill the viewport as the camera's body fades and grows past the edges,
// leaving the gallery (the site's real week navigation) as a full-screen,
// continuously moving photo wall. One rAF loop (gated by
// IntersectionObserver) reads native scrollTop every frame and writes a
// single --progress plus derived, clamped-linear "band" custom properties;
// every visual change is a pure calc() of those, so scrolling backwards is
// exactly the reverse of forwards and no wheel/scroll event is ever
// intercepted. The CSS custom-property *defaults* below already describe
// the finished, non-scrolling state (line art gone, monitor lit and open,
// gallery visible, monitor still docked/small rather than full-viewport),
// so prefers-reduced-motion and no-JS share that one static fallback: the
// script simply never overwrites them and the wrapper never grows past
// 100svh, so there is no dead scroll runway.
//
// Containing-block note: `.monitor-frame` becomes `position: fixed` during
// the expand stage. That only tracks the viewport if none of its ancestors
// use transform/perspective/filter/will-change — StickyCameraStage keeps
// `.camera-frame` (which *does* get scaled/faded out below) as a sibling of
// `.monitor-frame`, never an ancestor, specifically to protect this.
export interface Props {
  title: string;
  kicker: string;
  metaLine: string;
  weeks: GalleryWeek[];
}

const { title, kicker, metaLine, weeks } = Astro.props;
---

<section class="home-intro-stage" aria-label="Course introduction">
  <IntroGalleryStrip weeks={weeks} />
  <IdentityLayer title={title} kicker={kicker} metaLine={metaLine} />
</section>

<section class="course-thesis" aria-labelledby="course-thesis-heading">
  <div class="course-thesis-inner">
    <p class="course-thesis-kicker">Course intent · twelve shared frames</p>
    <h2 id="course-thesis-heading">Make photographs with someone, not just of them.</h2>
    <p class="course-thesis-copy">
      Partner Photography is a twelve-week studio in attention, trust and collaboration.
      We learn to plan together, direct without erasing personality, work with available
      light and choose photographs in which the person pictured still recognises themselves.
    </p>
  </div>
</section>

<div class="camera-reveal-sequence" id="camera-reveal-sequence">
  <StickyCameraStage weeks={weeks} />
</div>

<script>
  const wrapper = document.getElementById("camera-reveal-sequence");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (wrapper && !reduceMotion.matches && "IntersectionObserver" in window) {
    const sticky = wrapper.querySelector<HTMLElement>(".sticky-camera-stage");
    const monitorAnchor = wrapper.querySelector<HTMLElement>(".monitor-anchor");
    let active = false;
    let ticking = false;

    // Measured relative to the sticky stage box, not the tall wrapper: the
    // sticky box's *internal* layout never changes with scroll, so this
    // offset is valid no matter when it's taken. Once the stage is stuck
    // (top: 0, full-bleed), that offset equals the monitor's true
    // viewport-fixed coordinates — exactly what the expand calc() below needs.
    function measure() {
      if (!wrapper || !sticky || !monitorAnchor) return;
      const stageRect = sticky.getBoundingClientRect();
      const slotRect = monitorAnchor.getBoundingClientRect();
      const currentShift = Number.parseFloat(
        getComputedStyle(wrapper).getPropertyValue("--camera-y-shift"),
      ) || 0;
      wrapper.style.setProperty("--mon-left", `${slotRect.left - stageRect.left}px`);
      // The anchor moves upward with the camera. Store its unshifted origin so
      // both the illustration and the real monitor can consume the same live
      // --camera-y-shift without drifting apart after a resize.
      wrapper.style.setProperty("--mon-top", `${slotRect.top - stageRect.top + currentShift}px`);
      wrapper.style.setProperty("--mon-width", `${slotRect.width}px`);
      wrapper.style.setProperty("--mon-height", `${slotRect.height}px`);
    }

    function update() {
      ticking = false;
      if (!wrapper || !active) return;
      const rect = wrapper.getBoundingClientRect();
      const runway = rect.height - window.innerHeight;
      const progress = runway > 0 ? Math.min(1, Math.max(0, -rect.top / runway)) : 0;

      const band = (start: number, end: number) => Math.min(1, Math.max(0, (progress - start) / (end - start)));
      const materialize = band(0.04, 0.3);

      wrapper.style.setProperty("--progress", String(progress));
      wrapper.style.setProperty("--camera-y-shift", "0px");
      wrapper.style.setProperty("--b-materialize", String(materialize));
      wrapper.style.setProperty("--b-material-glow", String(Math.sin(Math.PI * materialize)));
      wrapper.style.setProperty("--material-scan-x", `${materialize * 2100}px`);
      wrapper.style.setProperty("--b-poweron", String(band(0.4, 0.5)));
      wrapper.style.setProperty("--b-shutter", String(band(0.51, 0.64)));
      wrapper.style.setProperty("--b-expand", String(band(0.62, 0.84)));
      wrapper.style.setProperty("--b-camera-exit", String(band(0.75, 0.9)));
      wrapper.style.setProperty("--b-gallery", String(band(0.73, 0.9)));
    }

    function schedule() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    function onResize() {
      measure();
      schedule();
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        active = entry?.isIntersecting ?? false;
        if (active) schedule();
      },
      { rootMargin: "200px 0px" },
    );
    io.observe(wrapper);

    wrapper.classList.add("is-animated");
    measure();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", onResize);
    schedule();
  }
</script>

<style>
  .home-intro-stage {
    --b-intro-exit: 0;
    position: relative;
    grid-column: full-start / full-end;
    height: 100svh;
    min-height: 38rem;
    isolation: isolate;
    overflow: hidden;
    background: #050506;
  }

  .course-thesis {
    position: relative;
    grid-column: full-start / full-end;
    display: grid;
    place-items: center;
    min-height: 68svh;
    overflow: hidden;
    padding: clamp(6rem, 14vh, 10rem) clamp(1.25rem, 8vw, 9rem);
    color: #f1eee7;
    background:
      radial-gradient(circle at 80% 20%, rgb(130 91 36 / 16%), transparent 34%),
      linear-gradient(135deg, #17191d, #090a0c 68%);
    border-block: 1px solid rgb(255 255 255 / 10%);
  }

  .course-thesis::before {
    content: "SLOP1810";
    position: absolute;
    inset-inline-end: clamp(1rem, 4vw, 4rem);
    inset-block-start: clamp(1.5rem, 4vh, 3.5rem);
    color: rgb(255 255 255 / 10%);
    font-family: var(--photo-metadata-font);
    font-size: clamp(2.5rem, 9vw, 9rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .course-thesis-inner {
    position: relative;
    z-index: 1;
    width: min(100%, 76rem);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
  }

  .course-thesis-kicker {
    grid-column: 1 / -1;
    margin: 0;
    color: rgb(241 238 231 / 56%);
    font-family: var(--photo-metadata-font);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .course-thesis h2 {
    margin: 0;
    max-width: 12ch;
    font-family: var(--photo-font-display);
    font-size: clamp(3rem, 6.6vw, 7.2rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .course-thesis-copy {
    margin: 0 0 0.5rem;
    color: rgb(241 238 231 / 72%);
    font-family: var(--at-font-body);
    font-size: clamp(1rem, 1.2vw, 1.22rem);
    line-height: 1.65;
  }

  .camera-reveal-sequence {
    --progress: 1;
    --mon-left: 0px;
    --mon-top: 0px;
    --mon-width: 100px;
    --mon-height: 60px;
    --camera-y-shift: 0px;
    --b-materialize: 1;
    --b-material-glow: 0;
    --material-scan-x: 2100px;
    --b-poweron: 1;
    --b-shutter: 1;
    --b-expand: 0;
    --b-camera-exit: 0;
    --b-gallery: 0;
    position: relative;
    grid-column: full-start / full-end;
    min-height: 100svh;
  }

  .camera-reveal-sequence.is-animated {
    min-height: 620vh;
  }

  @media (width < 640px) {
    .course-thesis {
      min-height: auto;
      padding-block: 7rem;
    }

    .course-thesis-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .course-thesis-kicker {
      grid-column: 1;
    }

    .camera-reveal-sequence.is-animated {
      min-height: 500vh;
    }
  }

  /* --- Dynamic, band-variable-driven rules reaching into child components'
     markup (Astro scoped CSS only auto-scopes this file's own elements, so
     descending into StickyCameraStage/IdentityLayer/MonitorFrame/etc.
     needs :global()). --- */

  :global(.camera-reveal-sequence .camera-frame) {
    opacity: calc(1 - var(--b-camera-exit, 0));
    transform: scale(calc(1 + 1.45 * var(--b-expand, 0)));
    transform-origin: 50% 58%;
  }

  :global(.camera-reveal-sequence .camera-visual) {
    transform: translate(-50%, -50%);
  }

  :global(.camera-reveal-sequence .monitor-hint) {
    opacity: calc(min(1, var(--b-materialize, 0) * 3) * (1 - min(1, var(--b-poweron, 0) * 2.2)));
  }

  :global(.camera-reveal-sequence .monitor-shutter--left) {
    transform: translateX(calc(var(--b-shutter, 0) * -105%));
  }

  :global(.camera-reveal-sequence .monitor-shutter--right) {
    transform: translateX(calc(var(--b-shutter, 0) * 105%));
  }

  :global(.camera-reveal-sequence .monitor-shutter--left::before),
  :global(.camera-reveal-sequence .monitor-shutter--right::before) {
    opacity: calc(var(--b-poweron, 0) * (1 - var(--b-shutter, 0)));
  }

  :global(.camera-reveal-sequence.is-animated .monitor-frame) {
    position: absolute;
    left: calc(var(--mon-left, 0px) * (1 - var(--b-expand, 0)));
    top: calc((var(--mon-top, 0px) - var(--camera-y-shift, 0px)) * (1 - var(--b-expand, 0)));
    width: calc(var(--mon-width, 100px) + (100vw - var(--mon-width, 100px)) * var(--b-expand, 0));
    height: calc(var(--mon-height, 60px) + (100svh - var(--mon-height, 60px)) * var(--b-expand, 0));
    border-width: calc(3px * (1 - var(--b-expand, 0)));
    border-radius: calc(12px * (1 - var(--b-expand, 0)));
    box-shadow:
      0 0 0 calc(3px * (1 - var(--b-expand, 0))) rgb(128 132 140 / 36%),
      0 0 0 calc(8px * (1 - var(--b-expand, 0))) #090a0c;
    z-index: 30;
  }

  :global(.camera-reveal-sequence .gallery-streams) {
    translate: 0 calc((1 - var(--b-gallery, 0)) * 1.5%);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.camera-reveal-sequence .camera-visual),
    :global(.camera-reveal-sequence .monitor-frame) {
      display: none;
    }
  }
</style>
