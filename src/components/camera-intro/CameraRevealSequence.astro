---
import { Image } from "astro:assets";
import StickyCameraStage from "./StickyCameraStage.astro";
import type { GalleryWeek } from "./FullscreenLectureGallery.astro";
import IdentityLayer from "./IdentityLayer.astro";
import IntroGalleryStrip from "./IntroGalleryStrip.astro";
import courseThesisWordmark from "../../assets/images/till-love-became-wordmark.png";
import photographerMascotUrl from "../../assets/images/photographer-mascot.gif?url";

// The homepage's signature opening. A giant, original SVG line drawing of a
// rear-view camera (CameraIllustration) fills the sticky stage; as the
// visitor scrolls, the exact same SVG geometry gains illustrated materials,
// shading and highlights in place — same position and silhouette
// throughout, never a different camera, never assets swapped in. Its rear
// monitor (MonitorFrame) then wakes up, its
// two shutters open from the centre to reveal FullscreenLectureGallery —
// mounted once, always present behind them — and the monitor expands to
// fill the viewport as the camera's body fades and grows past the edges,
// leaving the gallery (the site's real week navigation) as a full-screen,
// continuously moving photo wall. One rAF loop (gated by
// IntersectionObserver) reads native scrollTop and eases the displayed
// progress toward it over a few frames, absorbing discrete mouse-wheel steps
// without creating a second scroll system. It writes a single --progress plus
// derived, clamped-linear "band" custom properties; every visual change is a
// pure function of those, so scrolling backwards remains the exact reverse of
// forwards and no wheel/scroll event is ever intercepted. The CSS
// custom-property *defaults* below already describe
// the finished, non-scrolling state (line art gone, monitor lit and open,
// gallery visible, monitor still docked/small rather than full-viewport),
// so prefers-reduced-motion and no-JS share that one static fallback: the
// script simply never overwrites them and the wrapper never grows past
// 100svh, so there is no dead scroll runway.
//
// Containing-block note: `.monitor-frame` becomes `position: fixed` during
// the expand stage. That only tracks the viewport if none of its ancestors
// use transform/perspective/filter/will-change — StickyCameraStage keeps
// `.camera-frame` (which *does* get scaled/faded out below) as a sibling of
// `.monitor-frame`, never an ancestor, specifically to protect this.
export interface Props {
  title: string;
  kicker: string;
  metaLine: string;
  weeks: GalleryWeek[];
}

const { title, kicker, metaLine, weeks } = Astro.props;
---

<section class="home-intro-stage" aria-label="Course introduction">
  <IntroGalleryStrip weeks={weeks} />
  <IdentityLayer title={title} kicker={kicker} metaLine={metaLine} />
</section>

<section class="course-thesis" aria-labelledby="course-thesis-heading">
  <div class="course-thesis-inner">
    <p class="course-thesis-kicker">Course intent · twelve shared frames</p>
    <div class="course-thesis-slogan">
      <h2 id="course-thesis-heading" class="course-thesis-accessible-title">
        Till the Love Became a Photograph — 直到爱意变成一张照片
      </h2>
      <div class="course-thesis-wordmark-frame" aria-hidden="true">
        <Image
          src={courseThesisWordmark}
          alt=""
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 64rem) 48rem, 92vw"
          width={1600}
          format="webp"
          class="course-thesis-wordmark"
          loading="lazy"
        />
      </div>
      <img
        src={photographerMascotUrl}
        alt=""
        width="1024"
        height="1024"
        class="course-thesis-mascot"
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
    </div>
    <p class="course-thesis-copy">
      The camera can capture a face; the photograph should hold how well you know the
      person in front of it.<br />
      Across twelve weeks, learn to photograph your girlfriend or partner with care: ask
      how they wish to be seen, notice the moments that feel like them, and make images
      they love enough to keep. The most beautiful frame is the one they feel at home in.
    </p>
  </div>
</section>

<div class="camera-reveal-sequence" id="camera-reveal-sequence">
  <StickyCameraStage weeks={weeks} />
</div>

<script>
  function setupCameraRevealSequence() {
    const wrapperElement = document.getElementById("camera-reveal-sequence");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (
      !wrapperElement
      || wrapperElement.dataset.revealInitialized === "true"
      || reduceMotion.matches
      || !("IntersectionObserver" in window)
    ) return;

    const stickyElement = wrapperElement.querySelector<HTMLElement>(".sticky-camera-stage");
    const monitorAnchorElement = wrapperElement.querySelector<HTMLElement>(".monitor-anchor");
    if (!stickyElement || !monitorAnchorElement) return;

    const wrapper = wrapperElement;
    const sticky = stickyElement;
    const monitorAnchor = monitorAnchorElement;
    wrapper.dataset.revealInitialized = "true";
    let active = false;
    let ticking = false;
    let frame = 0;
    let destroyed = false;
    let displayedProgress: number | undefined;
    let lastFrameTime = 0;
    let snapNextFrame = false;
    let forceNextFrame = false;

    // A short time-based ease removes the visible stepping of a physical
    // mouse wheel while staying close enough to the native scroll position to
    // feel immediate. This is visual interpolation only: no wheel input or
    // page scroll is captured or rewritten.
    const progressEaseMs = 48;
    const progressEpsilon = 0.0004;

    // Measured relative to the sticky stage box, not the tall wrapper: the
    // sticky box's *internal* layout never changes with scroll, so this
    // offset is valid no matter when it's taken. Once the stage is stuck
    // (top: 0, full-bleed), that offset equals the monitor's true
    // viewport-fixed coordinates — exactly what the expand calc() below needs.
    function measure() {
      const stageRect = sticky.getBoundingClientRect();
      const slotRect = monitorAnchor.getBoundingClientRect();
      const currentShift = Number.parseFloat(
        getComputedStyle(wrapper).getPropertyValue("--camera-y-shift"),
      ) || 0;
      wrapper.style.setProperty("--mon-left", `${slotRect.left - stageRect.left}px`);
      // The anchor moves upward with the camera. Store its unshifted origin so
      // both the illustration and the real monitor can consume the same live
      // --camera-y-shift without drifting apart after a resize.
      wrapper.style.setProperty("--mon-top", `${slotRect.top - stageRect.top + currentShift}px`);
      wrapper.style.setProperty("--mon-width", `${slotRect.width}px`);
      wrapper.style.setProperty("--mon-height", `${slotRect.height}px`);
    }

    function update(timestamp: number) {
      ticking = false;
      frame = 0;
      const force = forceNextFrame;
      const snap = snapNextFrame;
      forceNextFrame = false;
      snapNextFrame = false;
      if (destroyed || !wrapper.isConnected || (!active && !force)) return;

      const rect = wrapper.getBoundingClientRect();
      const runway = rect.height - window.innerHeight;
      const targetProgress = runway > 0 ? Math.min(1, Math.max(0, -rect.top / runway)) : 0;

      if (displayedProgress === undefined || snap) {
        displayedProgress = targetProgress;
      } else {
        const elapsed = lastFrameTime > 0 ? Math.min(64, timestamp - lastFrameTime) : 16.67;
        const ease = 1 - Math.exp(-elapsed / progressEaseMs);
        displayedProgress += (targetProgress - displayedProgress) * ease;
        if (Math.abs(targetProgress - displayedProgress) < progressEpsilon) {
          displayedProgress = targetProgress;
        }
      }
      lastFrameTime = timestamp;
      const progress = displayedProgress;

      const band = (start: number, end: number) => Math.min(1, Math.max(0, (progress - start) / (end - start)));
      const materialize = band(0.03, 0.18);

      wrapper.style.setProperty("--progress", String(progress));
      wrapper.style.setProperty("--camera-y-shift", "0px");
      wrapper.style.setProperty("--b-materialize", String(materialize));
      wrapper.style.setProperty("--b-material-glow", String(Math.sin(Math.PI * materialize)));
      wrapper.style.setProperty("--material-scan-x", `${materialize * 2100}px`);
      wrapper.style.setProperty("--b-poweron", String(band(0.2, 0.27)));
      wrapper.style.setProperty("--b-shutter", String(band(0.26, 0.39)));
      wrapper.style.setProperty("--b-expand", String(band(0.37, 0.61)));
      wrapper.style.setProperty("--b-camera-exit", String(band(0.5, 0.69)));
      wrapper.style.setProperty("--b-gallery", String(band(0.48, 0.66)));

      if (active && Math.abs(targetProgress - displayedProgress) >= progressEpsilon) {
        schedule();
      }
    }

    function schedule({ snap = false, force = false }: { snap?: boolean; force?: boolean } = {}) {
      snapNextFrame ||= snap;
      forceNextFrame ||= force;
      if (!ticking && !destroyed) {
        ticking = true;
        frame = requestAnimationFrame(update);
      }
    }

    function onScroll() {
      schedule();
    }

    function onResize() {
      measure();
      schedule({ snap: true, force: true });
    }

    function onPageShow() {
      measure();
      schedule({ snap: true, force: true });
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        active = entry?.isIntersecting ?? false;
        if (active) {
          measure();
          schedule({ snap: displayedProgress === undefined });
        }
      },
      { rootMargin: "200px 0px" },
    );

    const resizeObserver = "ResizeObserver" in window
      ? new ResizeObserver(() => {
          measure();
          schedule({ snap: true, force: true });
        })
      : undefined;

    function cleanup() {
      destroyed = true;
      active = false;
      ticking = false;
      cancelAnimationFrame(frame);
      io.disconnect();
      resizeObserver?.disconnect();
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onResize);
      window.removeEventListener("pageshow", onPageShow);
      wrapper.classList.remove("is-animated");
      delete wrapper.dataset.revealInitialized;
    }

    io.observe(wrapper);
    resizeObserver?.observe(sticky);
    resizeObserver?.observe(monitorAnchor);

    wrapper.classList.add("is-animated");
    measure();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);
    window.addEventListener("pageshow", onPageShow);
    document.addEventListener("astro:before-swap", cleanup, { once: true });
    schedule({ snap: true, force: true });
  }

  setupCameraRevealSequence();
  document.addEventListener("astro:page-load", setupCameraRevealSequence);
</script>

<style>
  .home-intro-stage {
    --b-intro-exit: 0;
    position: relative;
    grid-column: full-start / full-end;
    height: 100svh;
    min-height: 38rem;
    margin-block: 0;
    isolation: isolate;
    overflow: hidden;
    background: #050506;
  }

  .course-thesis {
    position: relative;
    grid-column: full-start / full-end;
    display: grid;
    place-items: center;
    min-height: 68svh;
    margin-block: 0;
    overflow: hidden;
    padding: clamp(6rem, 14vh, 10rem) clamp(1.25rem, 8vw, 9rem);
    color: #f1eee7;
    background:
      radial-gradient(circle at 80% 20%, rgb(130 91 36 / 16%), transparent 34%),
      linear-gradient(135deg, #17191d, #090a0c 68%);
    border-block: 1px solid rgb(255 255 255 / 10%);
  }

  .course-thesis::before {
    content: "SLOP1810";
    position: absolute;
    inset-inline-end: clamp(1rem, 4vw, 4rem);
    inset-block-start: clamp(1.5rem, 4vh, 3.5rem);
    color: rgb(255 255 255 / 10%);
    font-family: var(--photo-metadata-font);
    font-size: clamp(2.5rem, 9vw, 9rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .course-thesis-inner {
    position: relative;
    z-index: 1;
    width: min(100%, 76rem);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
  }

  .course-thesis-kicker {
    grid-column: 1 / -1;
    margin: 0;
    color: rgb(241 238 231 / 56%);
    font-family: var(--photo-metadata-font);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .course-thesis-slogan {
    position: relative;
    min-width: 0;
    width: 100%;
    align-self: center;
  }

  .course-thesis-accessible-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .course-thesis-wordmark-frame {
    width: 100%;
    aspect-ratio: 3200 / 1750;
    overflow: hidden;
  }

  .course-thesis-wordmark {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1.25rem 2.5rem rgb(0 0 0 / 24%));
  }

  .course-thesis-mascot {
    position: absolute;
    z-index: 2;
    inset-block-start: -24%;
    inset-inline-start: 2%;
    width: clamp(7rem, 30%, 13rem);
    height: auto;
    pointer-events: none;
    filter: drop-shadow(0 0.9rem 1.4rem rgb(0 0 0 / 36%));
    transform: rotate(-4deg);
    transform-origin: 50% 70%;
  }

  .course-thesis-copy {
    margin: 0 0 0.5rem;
    color: rgb(241 238 231 / 72%);
    font-family: var(--at-font-body);
    font-size: clamp(1rem, 1.2vw, 1.22rem);
    line-height: 1.65;
  }

  .camera-reveal-sequence {
    --progress: 1;
    --mon-left: 0px;
    --mon-top: 0px;
    --mon-width: 100px;
    --mon-height: 60px;
    --camera-y-shift: 0px;
    --b-materialize: 1;
    --b-material-glow: 0;
    --material-scan-x: 2100px;
    --b-poweron: 1;
    --b-shutter: 1;
    --b-expand: 0;
    --b-camera-exit: 0;
    --b-gallery: 0;
    position: relative;
    grid-column: full-start / full-end;
    min-height: 100svh;
    margin-block: 0;
  }

  .camera-reveal-sequence.is-animated {
    min-height: 390vh;
  }

  @media (width < 640px) {
    .course-thesis {
      min-height: auto;
      padding-block: 7rem;
    }

    .course-thesis-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .course-thesis-slogan {
      width: min(100%, 38rem);
      margin-inline: auto;
    }

    .course-thesis-kicker {
      grid-column: 1;
    }

    .camera-reveal-sequence.is-animated {
      min-height: 350vh;
    }
  }

  /* --- Dynamic, band-variable-driven rules reaching into child components'
     markup (Astro scoped CSS only auto-scopes this file's own elements, so
     descending into StickyCameraStage/IdentityLayer/MonitorFrame/etc.
     needs :global()). --- */

  :global(.camera-reveal-sequence .camera-frame) {
    opacity: calc(1 - var(--b-camera-exit, 0));
    transform: scale(calc(1 + 1.45 * var(--b-expand, 0)));
    transform-origin: 50% 58%;
  }

  :global(.camera-reveal-sequence .camera-visual) {
    transform: translate(-50%, -50%);
  }

  :global(.camera-reveal-sequence .monitor-hint) {
    opacity: calc(min(1, var(--b-materialize, 0) * 3) * (1 - min(1, var(--b-poweron, 0) * 2.2)));
  }

  :global(.camera-reveal-sequence .monitor-shutter--left) {
    transform: translateX(calc(var(--b-shutter, 0) * -105%));
  }

  :global(.camera-reveal-sequence .monitor-shutter--right) {
    transform: translateX(calc(var(--b-shutter, 0) * 105%));
  }

  :global(.camera-reveal-sequence .monitor-shutter--left::before),
  :global(.camera-reveal-sequence .monitor-shutter--right::before) {
    opacity: calc(var(--b-poweron, 0) * (1 - var(--b-shutter, 0)));
  }

  :global(.camera-reveal-sequence.is-animated .monitor-frame) {
    position: absolute;
    left: calc(var(--mon-left, 0px) * (1 - var(--b-expand, 0)));
    top: calc((var(--mon-top, 0px) - var(--camera-y-shift, 0px)) * (1 - var(--b-expand, 0)));
    width: calc(var(--mon-width, 100px) + (100vw - var(--mon-width, 100px)) * var(--b-expand, 0));
    height: calc(var(--mon-height, 60px) + (100svh - var(--mon-height, 60px)) * var(--b-expand, 0));
    border-width: calc(3px * (1 - var(--b-expand, 0)));
    border-radius: calc(12px * (1 - var(--b-expand, 0)));
    box-shadow:
      0 0 0 calc(3px * (1 - var(--b-expand, 0))) rgb(128 132 140 / 36%),
      0 0 0 calc(8px * (1 - var(--b-expand, 0))) #090a0c;
    z-index: 30;
  }

  :global(.camera-reveal-sequence .gallery-streams) {
    translate: 0 calc((1 - var(--b-gallery, 0)) * 1.5%);
  }

  @media (prefers-reduced-motion: reduce) {
    .course-thesis-mascot {
      display: none;
    }

    :global(.camera-reveal-sequence .camera-visual),
    :global(.camera-reveal-sequence .monitor-frame) {
      display: none;
    }
  }
</style>
