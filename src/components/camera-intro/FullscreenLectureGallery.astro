---
import { withBase } from "astro-theme-university/url";
import MediaSlot from "../MediaSlot.astro";

// The sequence's destination and payoff: a dense, irregular photo wall
// mounted exactly once, always present behind MonitorFrame's shutters —
// never a second/placeholder gallery swapped in after the animation. Every
// tile is a real <a href="/weeks/NN/"> link, so it is the site's actual
// navigation to all twelve lecture weeks, not a decorative mockup of one.
export interface GalleryWeek {
  week: number;
  number: string;
  title: string;
  href: string;
  placeholderCaption: string;
  tone: "warm" | "cool" | "neutral";
}

export interface Props {
  weeks: GalleryWeek[];
}

const { weeks } = Astro.props;

// Deliberately irregular column/row spans (a 12-column track) so the wall
// reads as a staggered photo mosaic rather than a uniform card grid — no
// two adjacent tiles share the same shape, and grid-auto-flow: dense lets
// the browser interleave them rather than settling into clean rows.
const colSpans = [5, 4, 3, 6, 4, 3, 5, 3, 4, 6, 3, 5];
const rowSpans = [2, 1, 2, 1, 1, 2, 1, 2, 1, 1, 2, 1];
const driftDurations = [16, 21, 18, 24, 15, 22, 19, 26, 17, 23, 20, 25];

const tiles = weeks.map((entry, i) => ({
  ...entry,
  colSpan: colSpans[i % colSpans.length],
  rowSpan: rowSpans[i % rowSpans.length],
  driftDuration: driftDurations[i % driftDurations.length],
  driftDirection: i % 2 === 0 ? 1 : -1,
  driftDistance: 8 + (i % 4) * 5,
}));
---

<section class="fullscreen-gallery" aria-labelledby="fullscreen-gallery-heading">
  <h2 id="fullscreen-gallery-heading" class="fullscreen-gallery-heading">Twelve weeks, one photograph each</h2>
  <ul class="fullscreen-gallery-grid" role="list">
    {
      tiles.map((tile) => (
        <li
          class="gallery-tile"
          style={`grid-column: span ${tile.colSpan}; grid-row: span ${tile.rowSpan}; --drift-duration: ${tile.driftDuration}s; --drift-direction: ${tile.driftDirection}; --drift-distance: ${tile.driftDistance}px;`}
        >
          <a class="gallery-tile-link" href={withBase(tile.href)} aria-label={`Week ${tile.number} — ${tile.title}`}>
            <MediaSlot tone={tile.tone} numeral={tile.number} caption={tile.placeholderCaption} ratio="auto" />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .fullscreen-gallery {
    position: absolute;
    inset: 0;
    background: var(--photo-ink);
  }

  .fullscreen-gallery-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .fullscreen-gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 1fr;
    grid-auto-flow: dense;
    gap: clamp(1px, 0.3vw, 4px);
  }

  .gallery-tile {
    position: relative;
    overflow: hidden;
  }

  .gallery-tile-link {
    position: absolute;
    inset: 0;
    display: block;
  }

  .gallery-tile-link :global(.media-slot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gallery-tile-link {
      animation: gallery-tile-drift var(--drift-duration, 18s) ease-in-out infinite;
    }
  }

  @keyframes gallery-tile-drift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(calc(var(--drift-distance, 10px) * var(--drift-direction, 1)));
    }
  }

  .gallery-tile-link:focus-visible {
    outline: 2px solid var(--photo-cream);
    outline-offset: -2px;
    z-index: 1;
  }

  @media (width < 640px) {
    .fullscreen-gallery-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .gallery-tile {
      grid-column: span 3 !important;
      grid-row: span 1 !important;
    }
  }
</style>
