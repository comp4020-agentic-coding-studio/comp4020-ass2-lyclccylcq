---
import CameraIllustration from "./CameraIllustration.astro";
import type { GalleryWeek } from "./FullscreenLectureGallery.astro";
import IdentityLayer from "./IdentityLayer.astro";
import MonitorFrame from "./MonitorFrame.astro";

// The single sticky box that stays pinned for the whole scroll sequence.
// `.camera-frame` (line art + rendered colour) and `.monitor-anchor`/`.monitor-frame`
// are siblings, not nested — CameraRevealSequence fades/scales
// `.camera-frame` out during the expand stage, and that must never apply a
// transform to an ancestor of `.monitor-frame`, or the monitor's later
// `position: fixed` would be re-parented to that ancestor instead of the
// viewport (see the containing-block note in CameraRevealSequence).
export interface Props {
  title: string;
  kicker: string;
  metaLine: string;
  weeks: GalleryWeek[];
}

const { title, kicker, metaLine, weeks } = Astro.props;
---

<div class="sticky-camera-stage">
  <IdentityLayer title={title} kicker={kicker} metaLine={metaLine} />
  <div class="camera-visual">
    <div class="camera-frame">
      <CameraIllustration />
    </div>
    <div class="monitor-anchor" aria-hidden="true"></div>
  </div>
  <MonitorFrame weeks={weeks} />
</div>

<style>
  .sticky-camera-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 46%, rgb(42 46 54 / 34%), transparent 48%),
      #050506;
  }

  .camera-visual {
    position: absolute;
    left: 50%;
    top: 53%;
    width: min(96vw, 158svh);
    aspect-ratio: 1600 / 1000;
    transform: translate(-50%, -50%);
  }

  .camera-frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .monitor-anchor {
    position: absolute;
    left: 26.25%;
    top: 38.5%;
    width: 47.5%;
    height: 42%;
    pointer-events: none;
    visibility: hidden;
  }

  @media (width < 640px) {
    .camera-visual {
      top: 60%;
      width: min(156vw, 146svh);
    }
  }
</style>
