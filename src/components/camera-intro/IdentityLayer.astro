---
import { slopBranding } from "astro-theme-slop";

// The opening moment's only text/mark content: the official SlopU logo,
// the page's real <h1>, a one-line metadata kicker and a short line of
// course identity. Uses slopBranding.logoDark — the theme's own official
// light-on-dark lockup, not a recoloured/redrawn mark — since this sits on
// the new dark hero. Restrained and small relative to the giant camera —
// never LAYR's logo/menu/labels or any of its copy. Fades out as the
// monitor begins to open (CameraRevealSequence drives --b-identity off the
// same --b-poweron timing) so it never competes with the shutter/gallery
// sequence.
export interface Props {
  title: string;
  kicker: string;
  metaLine: string;
}

const { title, kicker, metaLine } = Astro.props;
---

<div class="identity-layer">
  <img
    class="identity-layer-logo"
    src={slopBranding.logoDark.src}
    width={slopBranding.logoDark.width}
    height={slopBranding.logoDark.height}
    alt="Slop University"
  />
  <p class="identity-layer-kicker">{kicker}</p>
  <h1 class="identity-layer-title">{title}</h1>
  <p class="identity-layer-meta">{metaLine}</p>
  <span class="identity-layer-scroll" aria-hidden="true">Scroll to enter</span>
</div>

<style>
  .identity-layer {
    position: absolute;
    inset-inline-start: clamp(1.25rem, 5vw, 5rem);
    inset-block-start: clamp(6rem, 14vh, 8.5rem);
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    max-width: min(46rem, 72vw);
    text-align: left;
    color: #fff;
    pointer-events: none;
  }

  .identity-layer-logo {
    display: none;
  }

  .identity-layer-kicker {
    margin: 0;
    font-family: var(--photo-metadata-font);
    font-size: var(--at-font-size-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.68;
  }

  .identity-layer-title {
    margin: 0;
    font-family: var(--photo-font-display);
    font-weight: 400;
    max-width: 11.5ch;
    font-size: clamp(3.1rem, 1.6rem + 5.5vw, 7rem);
    line-height: 0.86;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .identity-layer-meta {
    margin: 0;
    font-family: var(--photo-metadata-font);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.06em;
    opacity: 0.64;
  }

  .identity-layer-scroll {
    margin-block-start: 0.45rem;
    font-family: var(--photo-metadata-font);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  @media (width < 640px) {
    .identity-layer {
      inset-inline: 1.1rem;
      inset-block-start: 5.75rem;
      max-width: none;
    }

    .identity-layer-title {
      max-width: calc(100vw - 2.2rem);
      font-size: clamp(2.6rem, 12vw, 3.3rem);
      line-height: 0.9;
    }

    .identity-layer-meta {
      max-width: 26ch;
    }
  }
</style>
