---
// Large, full-width statement that enters independently of any media —
// oversized display type, generous negative space, a restrained
// scroll-triggered reveal (opacity/translate only, gated behind
// prefers-reduced-motion, never intercepting the scroll itself).
export interface Props {
  statement: string;
  support?: string;
}

const { statement, support } = Astro.props;
---

<section class="moving-statement" aria-label="Course statement">
  <p class="moving-statement-text" data-reveal>{statement}</p>
  {support && (
    <p class="moving-statement-support" data-reveal>
      {support}
    </p>
  )}
</section>

<script>
  const targets = document.querySelectorAll<HTMLElement>(".moving-statement [data-reveal]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (reduceMotion.matches || !("IntersectionObserver" in window)) {
    targets.forEach((el) => el.classList.add("is-visible"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>

<style>
  .moving-statement {
    grid-column: full-start / full-end;
    padding-block: clamp(4rem, 14vw, 9rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .moving-statement-text {
    margin: 0;
    font-family: var(--photo-font-display);
    font-weight: 400;
    font-size: clamp(2rem, 1.1rem + 4.5vw, 5.5rem);
    line-height: 1.05;
    max-width: 22ch;
  }

  .moving-statement-support {
    margin: 0;
    max-width: 42ch;
    font-size: clamp(1rem, 0.9rem + 0.3vw, 1.15rem);
    color: var(--at-text-secondary);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
