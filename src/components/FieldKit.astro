---
export interface FieldKitItem {
  label: string;
  note?: string;
}

export interface Props {
  items: FieldKitItem[];
}

const { items } = Astro.props;
---

<section class="field-kit">
  <h2>Field kit</h2>
  <p>What to have with you before you shoot. This list is still being built out.</p>
  <ul class="field-kit-list">
    {
      items.map((item) => (
        <li>
          <span class="field-kit-box" aria-hidden="true" />
          <span>
            {item.label}
            {item.note && <small> — {item.note}</small>}
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .field-kit-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .field-kit-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .field-kit-box {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-block-start: 0.2rem;
    border: 1px solid var(--at-border);
  }

  .field-kit-list small {
    color: var(--at-text-secondary);
  }
</style>
