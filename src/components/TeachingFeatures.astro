---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import MediaSlot from "./MediaSlot.astro";

// Alternating numbered teaching features: one offset image paired with a
// heading and short copy per feature, alternating left/right — replaces
// the old single "photo feature" + separate "comparison" layouts with one
// consistent, repeatable pattern.
export interface TeachingFeature {
  number: string;
  title: string;
  body: string;
  image?: ImageMetadata;
  imageAlt?: string;
  placeholderCaption: string;
  tone: "warm" | "cool" | "neutral";
}

export interface Props {
  heading: string;
  features: TeachingFeature[];
}

const { heading, features } = Astro.props;
---

<section class="teaching-features" aria-labelledby="teaching-features-heading">
  <h2 id="teaching-features-heading" class="teaching-features-heading">{heading}</h2>
  {
    features.map((feature, i) => (
      <article class="teaching-feature" data-align={i % 2 === 0 ? "left" : "right"}>
        <div class="teaching-feature-media">
          {feature.image ? (
            <Image src={feature.image} alt={feature.imageAlt ?? ""} class="teaching-feature-image" loading="lazy" />
          ) : (
            <MediaSlot caption={feature.placeholderCaption} tone={feature.tone} ratio="4 / 3" numeral={feature.number} />
          )}
        </div>
        <div class="teaching-feature-text">
          <span class="teaching-feature-number" aria-hidden="true">
            {feature.number}
          </span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </div>
      </article>
    ))
  }
</section>

<style>
  .teaching-features {
    grid-column: full-start / full-end;
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .teaching-features-heading {
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    max-width: 30ch;
    margin: 0 0 clamp(2rem, 5vw, 3rem);
  }

  .teaching-feature {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    border-block-start: 1px solid var(--at-divider);
  }

  .teaching-feature:last-child {
    border-block-end: 1px solid var(--at-divider);
  }

  @media (width >= 800px) {
    .teaching-feature {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }

    .teaching-feature[data-align="right"] {
      grid-template-columns: 1fr 1.1fr;
    }

    .teaching-feature[data-align="right"] .teaching-feature-media {
      order: 2;
    }

    .teaching-feature[data-align="right"] .teaching-feature-text {
      order: 1;
    }
  }

  .teaching-feature-media :global(img),
  .teaching-feature-media :global(.media-slot) {
    width: 100%;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .teaching-feature-media:hover :global(img),
    .teaching-feature-media:hover :global(.media-slot) {
      transform: scale(1.02);
    }
  }

  .teaching-feature-number {
    display: block;
    font-family: var(--photo-font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    color: var(--photo-accent);
    margin-block-end: 0.5rem;
  }

  .teaching-feature-text h3 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.3rem, 1.1rem + 1vw, 1.9rem);
  }

  .teaching-feature-text p {
    margin: 0;
    color: var(--at-text-secondary);
    max-width: 48ch;
  }
</style>
