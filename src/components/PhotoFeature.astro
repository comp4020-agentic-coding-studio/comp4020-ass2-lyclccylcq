---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// One teaching concept, full-width editorial treatment: a large image at
// roughly two-thirds width with a smaller text block overlapping it, meant
// to break the page's rhythm rather than continue the section-after-section
// pattern.
export interface Props {
  kicker: string;
  title: string;
  body: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { kicker, title, body, image, imageAlt } = Astro.props;
---

<section class="photo-feature" aria-labelledby="photo-feature-heading">
  <div class="photo-feature-image-wrap">
    <Image src={image} alt={imageAlt} class="photo-feature-image" />
  </div>
  <div class="photo-feature-text">
    <p class="photo-feature-kicker">{kicker}</p>
    <h2 id="photo-feature-heading">{title}</h2>
    <p>{body}</p>
  </div>
</section>

<style>
  .photo-feature {
    grid-column: inset-start / content-end;
    display: grid;
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }

  @media (width >= 800px) {
    .photo-feature {
      grid-template-columns: minmax(0, 66%) minmax(0, 1fr);
      align-items: end;
    }
  }

  .photo-feature-image-wrap {
    padding-inline: var(--at-spacing-md);
  }

  @media (width >= 800px) {
    .photo-feature-image-wrap {
      padding-inline-start: clamp(1.5rem, 5vw, 5rem);
      padding-inline-end: 0;
    }
  }

  .photo-feature-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center 70%;
    border-radius: var(--at-border-radius);
    box-shadow: var(--at-shadow-lg);
  }

  .photo-feature-text {
    background: var(--at-bg-elevated);
    backdrop-filter: blur(12px);
    box-shadow: var(--at-shadow-md);
    border-radius: var(--at-border-radius);
    padding: var(--at-spacing-xl);
    margin-inline: var(--at-spacing-md);
    margin-block-start: -2rem;
    position: relative;
  }

  @media (width >= 800px) {
    .photo-feature-text {
      margin-inline-start: -3rem;
      margin-inline-end: clamp(1.5rem, 5vw, 5rem);
      margin-block-start: 0;
    }
  }

  .photo-feature-kicker {
    font-family: var(--photo-metadata-font);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--photo-accent-deep);
    margin-block-end: 0.5em;
  }

  .photo-feature-text h2 {
    margin-block-start: 0;
  }
</style>
