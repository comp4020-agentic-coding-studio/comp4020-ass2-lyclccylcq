---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { withBase } from "astro-theme-university/url";

// Replaces the theme's Hero (a single full-bleed image + bottom h1) with an
// asymmetric two-part composition: text block left, tall portrait-cropped
// image right. Owns the page's <h1> directly, so pages using this pass no
// heroImage/heroTitle to ContentLayout.
export interface Props {
  kicker: string;
  title: string;
  intro: string;
  ctaHref: string;
  ctaLabel: string;
  image: ImageMetadata;
  imageAlt: string;
  caption?: string;
}

const { kicker, title, intro, ctaHref, ctaLabel, image, imageAlt, caption } = Astro.props;
---

<section class="editorial-hero" aria-label={title}>
  <div class="editorial-hero-text">
    <p class="editorial-hero-kicker">{kicker}</p>
    <h1 class="editorial-hero-title">{title}</h1>
    <p class="editorial-hero-intro">{intro}</p>
    <a class="photo-cta" href={withBase(ctaHref)}>{ctaLabel}</a>
  </div>
  <div class="editorial-hero-image-wrap">
    <Image src={image} alt={imageAlt} class="editorial-hero-image" />
    {caption && <p class="editorial-hero-caption">{caption}</p>}
  </div>
</section>

<style>
  .editorial-hero {
    grid-column: inset-start / content-end;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block-start: clamp(1rem, 3vw, 2rem);
  }

  @media (width >= 900px) {
    .editorial-hero {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: center;
      padding-inline: clamp(1rem, 3vw, 2rem);
    }
  }

  .editorial-hero-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-inline: var(--at-spacing-md);
  }

  @media (width >= 900px) {
    .editorial-hero-text {
      padding-inline: 0;
    }
  }

  .editorial-hero-kicker {
    font-family: var(--photo-metadata-font);
    font-size: var(--at-font-size-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--photo-accent-deep);
    margin: 0;
  }

  .editorial-hero-title {
    font-family: var(--photo-font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 3.75rem);
    line-height: 1.02;
    hyphens: auto;
    margin: 0;
    color: var(--photo-pink-deep);
  }

  .editorial-hero-intro {
    font-size: var(--at-font-size-base);
    color: var(--at-text-secondary);
    max-width: 32ch;
    margin: 0;
  }

  .editorial-hero-image-wrap {
    position: relative;
    padding-inline: var(--at-spacing-md);
  }

  @media (width >= 900px) {
    .editorial-hero-image-wrap {
      padding-inline: 0;
    }
  }

  .editorial-hero-image {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 30%;
    border-radius: var(--at-border-radius);
    box-shadow: var(--at-shadow-lg);
  }

  .editorial-hero-caption {
    position: absolute;
    right: calc(var(--at-spacing-md) + 0.75rem);
    bottom: -1rem;
    margin: 0;
    padding: 0.5em 1em;
    background: var(--at-bg-elevated);
    backdrop-filter: blur(10px);
    border-radius: 999px;
    box-shadow: var(--at-shadow-md);
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
  }

  @media (width >= 900px) {
    .editorial-hero-caption {
      right: -1rem;
    }
  }
</style>
