---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { withBase } from "astro-theme-university/url";

export interface ContactSheetFrame {
  /** Frame number label, e.g. "01". */
  number: string;
  /** Frame title, e.g. "Week 01". */
  title: string;
  /** Link target. */
  href: string;
  /** Optional caption shown under the title. */
  caption?: string;
  /** Optional full-bleed photograph for the frame. */
  image?: ImageMetadata;
  /** Alternative text for a meaningful frame image; omit for decorative images. */
  imageAlt?: string;
}

export interface ContactSheetGridProps {
  frames: ContactSheetFrame[];
}

type Props = ContactSheetGridProps;

const { frames } = Astro.props;
---

<ul class="photo-contact-sheet" role="list">
  {
    frames.map((frame) => (
      <li>
        <a class="photo-frame contact-sheet-frame" href={withBase(frame.href)}>
          {
            frame.image && (
              <span class="contact-sheet-frame-media" aria-hidden={!frame.imageAlt ? "true" : undefined}>
                <Image
                  src={frame.image}
                  alt={frame.imageAlt ?? ""}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 36rem) 100vw, (max-width: 64rem) 50vw, 33vw"
                  format="webp"
                  class="contact-sheet-frame-image"
                  loading="lazy"
                />
              </span>
            )
          }
          <span class="photo-frame-number">{frame.number}</span>
          <span class="contact-sheet-frame-title">{frame.title}</span>
          {frame.caption && <span class="contact-sheet-frame-caption">{frame.caption}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .photo-contact-sheet {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-sheet-frame {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    aspect-ratio: 1;
    justify-content: space-between;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: var(--at-bg-elevated);
    border-color: transparent;
    box-shadow: var(--at-shadow-sm);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .contact-sheet-frame::before,
  .contact-sheet-frame::after {
    z-index: 3;
  }

  li:nth-child(3n + 1) .contact-sheet-frame {
    background: color-mix(in oklch, var(--photo-peach-tint) 55%, var(--at-bg-elevated));
  }

  li:nth-child(3n + 2) .contact-sheet-frame {
    background: color-mix(in oklch, var(--photo-sky-tint) 55%, var(--at-bg-elevated));
  }

  li:nth-child(3n) .contact-sheet-frame {
    background: color-mix(in oklch, var(--photo-mint-tint) 55%, var(--at-bg-elevated));
  }

  .contact-sheet-frame:hover,
  .contact-sheet-frame:focus-visible {
    border-color: var(--photo-accent);
    box-shadow: var(--at-shadow-md);
    transform: translateY(-3px) scale(1.02);
  }

  .contact-sheet-frame-media {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
  }

  .contact-sheet-frame-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(8 12 18 / 46%) 0%, transparent 38%),
      linear-gradient(0deg, rgb(8 12 18 / 84%) 0%, rgb(8 12 18 / 8%) 64%);
    pointer-events: none;
  }

  .contact-sheet-frame-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.002);
    transition: transform 0.35s ease;
  }

  .contact-sheet-frame:hover .contact-sheet-frame-image,
  .contact-sheet-frame:focus-visible .contact-sheet-frame-image {
    transform: scale(1.055);
  }

  .photo-frame-number,
  .contact-sheet-frame-title,
  .contact-sheet-frame-caption {
    position: relative;
    z-index: 2;
    text-shadow: 0 1px 0.5rem rgb(0 0 0 / 55%);
  }

  .photo-frame-number {
    align-self: flex-start;
    padding: 0.25rem 0.45rem;
    color: #fff;
    background: rgb(8 12 18 / 36%);
    border: 1px solid rgb(255 255 255 / 34%);
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }

  .contact-sheet-frame-title {
    margin-block-start: auto;
    font-weight: 600;
    font-size: clamp(var(--at-font-size-base), 2.2vw, var(--at-font-size-lg));
  }

  .contact-sheet-frame-caption {
    font-size: var(--at-font-size-xs);
    color: rgb(255 255 255 / 86%);
  }
</style>
