---
import { withBase } from "astro-theme-university/url";

export interface ContactSheetFrame {
  /** Frame number label, e.g. "01". */
  number: string;
  /** Frame title, e.g. "Week 01". */
  title: string;
  /** Link target. */
  href: string;
  /** Optional caption shown under the title. */
  caption?: string;
}

export interface ContactSheetGridProps {
  frames: ContactSheetFrame[];
}

type Props = ContactSheetGridProps;

const { frames } = Astro.props;
---

<ul class="photo-contact-sheet" role="list">
  {
    frames.map((frame) => (
      <li>
        <a class="photo-frame contact-sheet-frame" href={withBase(frame.href)}>
          <span class="photo-frame-number">{frame.number}</span>
          <span class="contact-sheet-frame-title">{frame.title}</span>
          {frame.caption && <span class="contact-sheet-frame-caption">{frame.caption}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .photo-contact-sheet {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-sheet-frame {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    aspect-ratio: 1;
    justify-content: space-between;
    color: var(--at-text);
    background: var(--at-bg-elevated);
    backdrop-filter: blur(10px);
    border-color: transparent;
    box-shadow: var(--at-shadow-sm);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  li:nth-child(3n + 1) .contact-sheet-frame {
    background: color-mix(in oklch, var(--photo-peach-tint) 55%, var(--at-bg-elevated));
  }

  li:nth-child(3n + 2) .contact-sheet-frame {
    background: color-mix(in oklch, var(--photo-sky-tint) 55%, var(--at-bg-elevated));
  }

  li:nth-child(3n) .contact-sheet-frame {
    background: color-mix(in oklch, var(--photo-mint-tint) 55%, var(--at-bg-elevated));
  }

  .contact-sheet-frame:hover,
  .contact-sheet-frame:focus-visible {
    border-color: var(--photo-accent-deep);
    box-shadow: var(--at-shadow-md);
    transform: translateY(-3px) scale(1.02);
  }

  .contact-sheet-frame-title {
    font-weight: 600;
    font-size: var(--at-font-size-base);
  }

  .contact-sheet-frame-caption {
    font-size: var(--at-font-size-xs);
    color: var(--at-text-secondary);
  }
</style>
